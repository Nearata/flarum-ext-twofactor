{
    "name": "nearata/flarum-ext-twofactor",
    "description": "Allows your users to activate 2FA authentication.",
    "keywords": [
        "flarum",
        "twofactor",
        "security"
    ],
    "type": "flarum-extension",
    "license": "Unlicense",
    "require": {
        "php": "^8.1",
        "flarum/core": "^1.8.0",
        "spomky-labs/otphp": "^11.3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20.0"
    },
    "authors": [
        {
            "name": "Nearata",
            "homepage": "https://nearata.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nearata\\TwoFactor\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Two Factor",
            "category": "feature",
            "icon": {
                "name": "fas fa-shield-alt",
                "backgroundColor": "#D72638",
                "color": "#fff"
            }
        }
    },
    "scripts": {
        "format": "pint src"
    }
}
